{
  "buildCommand": "cd frontend && npm install --no-audit --no-fund && (chmod +x node_modules/.bin/* 2>/dev/null || true) && npm run build",
  "outputDirectory": "frontend/dist",
  "env": {
    "UV_LINK_MODE": "copy"
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/api",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
